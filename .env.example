# Entorno de desarrollo/staging. Sin secretos reales en el repo.
NODE_ENV=development
PORT=3000

# Supabase (C03). Sin estos valores la API falla cerrada (401), no cae a owner/default.
SUPABASE_PROJECT_REF=
SUPABASE_ISSUER=
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
# Solo para desarrollo legacy HS256; en producción se prefiere clave asimétrica.
SUPABASE_JWT_SECRET=

# Conectores (C09). Todos deshabilitados por defecto.
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=
TWENTY_ENABLED=false
FRAPPE_ENABLED=false
ZAMMAD_ENABLED=false
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false

# Presencia (C32). Sin API key las sesiones devuelven not_configured.
ANAM_ENABLED=false
ANAM_API_KEY=
ANAM_BASE_URL=https://api.anam.ai

# Presupuesto (C37)
BUDGET_LITE_EUR=30
BUDGET_L_ENABLED=false

# Base de datos (C06). Sin DATABASE_URL se usa el repositorio en memoria.
DATABASE_URL=
